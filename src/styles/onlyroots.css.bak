



:root {
  --or-green: #5a9e74;
  --or-green-dark: #3f6e51;
  --or-dark: #3d3d3d;
  --or-dark-soft: #383838;
  --or-grey: #868686;
  --or-grey-light: #a0a0a0;
  --or-grey-lighter: #e8e8e8;
  --or-bg-soft: #f1f1f1;
  --or-text: #0d0d0d;
  --or-text-muted: #43474a;
}

body { font-family: 'Roboto', sans-serif; color: var(--or-text); background: #fff; margin: 0; }
h1, h2, h3, h4, h5, .h4 { font-family: 'Roboto Condensed', sans-serif; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
a { color: inherit; }

.material-icons {
  font-family: 'Material Icons';
  font-weight: normal; font-style: normal;
  display: inline-block; line-height: 1;
  text-transform: none; letter-spacing: normal;
  word-wrap: normal; white-space: nowrap; direction: ltr;
}

/* Mega-menu items : animation underline blanc au survol (left to right) */
.megamenu-item {
  position: relative;
}
.megamenu-item::after {
  content: '';
  position: absolute;
  left: 18px;
  right: 18px;
  bottom: 8px;
  height: 2px;
  background: #fff;
  transform: scaleX(0);
  transform-origin: left center;
  transition: transform 0.3s ease;
  pointer-events: none;
}
.megamenu-item:hover::after,
.megamenu-has-dropdown:hover > .megamenu-item::after {
  transform: scaleX(1);
}

.btn-or-green {
  background: var(--or-green); color: #fff; border: none;
  padding: 8px 16px; border-radius: 4px; font-weight: 600;
  cursor: pointer; font-family: inherit;
}
.btn-or-green:hover { background: var(--or-green-dark); }

/* Mega-menu hover effect */
.megamenu-list { position: relative; }
.megamenu-has-dropdown:hover .megamenu-dropdown { display: block !important; }
.megamenu-dropdown a:hover { background: var(--or-bg-soft); }

/* Hover effect sur cartes produit (lift + shadow comme OnlyRoots) */
.product-card {
  transition: transform 0.25s ease, box-shadow 0.25s ease;
  will-change: transform;
}
.product-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18);
}

/* Hover effect sur bouton play (scale + glow jaune) */
.product-play-button:not(:disabled) {
  transition: transform 0.18s ease, background-color 0.18s ease, box-shadow 0.18s ease;
}
.product-play-button:not(:disabled):hover {
  transform: scale(1.12);
  background-color: #f5b94c !important;
  box-shadow: 0 4px 14px rgba(232, 168, 56, 0.55);
}
.product-play-button:not(:disabled):active {
  transform: scale(0.96);
}






