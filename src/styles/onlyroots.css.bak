/* Œil au centre de l'image, anim scale au hover */
.product-card-hover-eye {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.35s ease;
  pointer-events: none;
  z-index: 3;
}
.product-card-hover-eye svg {
  transform: scale(0.3);
  transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  filter: drop-shadow(0 1px 4px rgba(0,0,0,0.25));
}
.product-card:hover .product-card-hover-eye { opacity: 1; }
.product-card:hover .product-card-hover-eye svg { transform: scale(1); }
